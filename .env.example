# Flask Configuration
SECRET_KEY=your_secret_key_here_change_this_in_production
FLASK_ENV=development
FLASK_DEBUG=1

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pdf_processing
# For MongoDB Atlas (uncomment and modify):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/pdf_processing?retryWrites=true&w=majority

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=your-pdf-bucket-name

# Production MongoDB (for docker-compose.prod.yml)
MONGO_ROOT_PASSWORD=secure_password_change_this

# Optional: Custom settings
# MAX_FILE_SIZE=10485760  # 10MB in bytes
# ALLOWED_EXTENSIONS=pdf
# UPLOAD_FOLDER=uploads 